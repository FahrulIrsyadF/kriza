# ========================
# ENVIRONMENT VARIABLES
# Copy file ini ke .env dan isi nilainya
# JANGAN COMMIT file .env ke git
# ========================

# --- Database ---
DATABASE_URL=postgresql://kriza:kriza_secret@localhost:5432/kriza_dev

# --- API Server ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Authentication ---
# JWT tunggal yang expire tiap tengah malam WIB (tidak ada refresh token)
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_random_string_minimal_32_karakter_dan_keep_secret

# Timezone offset klinik (default 7 = WIB/UTC+7)
CLINIC_TIMEZONE_OFFSET=7

# --- Frontend (prefix VITE_ agar ter-expose ke browser) ---
VITE_API_URL=http://localhost:3001
